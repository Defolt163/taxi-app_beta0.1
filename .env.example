# Copy this file to .env and replace every placeholder before starting Compose.
MARIADB_ROOT_PASSWORD=replace-with-a-long-unique-password
MARIADB_USER=taxicap_app
MARIADB_PASSWORD=replace-with-another-long-unique-password
MARIADB_DATABASE=taxicap_actual
MARIADB_PORT=3307
PHPMYADMIN_PORT=8081
WEB_PORT=3000
API_PORT=8080

# Keep JWT_SECRET_KEY identical to the key used to sign existing user tokens.
JWT_SECRET_KEY=replace-with-the-existing-jwt-secret
DATA_SECRET_KEY=replace-with-the-existing-data-encryption-key
PUSH_INTERNAL_SECRET=replace-with-a-shared-random-secret

# Values used by the browser bundle at build time.
NEXT_PUBLIC_LAT_UP=54.414919
NEXT_PUBLIC_LON_UP=51.492640
NEXT_PUBLIC_LAT_BOTTOM=54.452460
NEXT_PUBLIC_LON_BOTTOM=51.442057
NEXT_PUBLIC_MAP_API_KEY=replace-with-your-map-api-key
NEXT_PUBLIC_MYSQL_API=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key

# Optional: override the addresses of the existing host-side map containers.
TILE_SERVER_URL=http://host.docker.internal:8001
NOMINATIM_SERVER_URL=http://host.docker.internal:8003
VALHALLA_SERVER_URL=http://host.docker.internal:8002
